# Copy this file to .env and fill in real values. Do not commit .env.

# Google AI Studio key. The app calls hosted gemma-4-26b-a4b-it.
GEMINI_API_KEY=

# ElevenLabs speech. The default voice is Matilda, which works on the free plan.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX

# MongoDB Atlas connection string. Encode a % in the password as %25.
MONGO_URI=
# MONGO_DB_NAME=omnicall_ai

# Sentry DSN for the agent trace.
SENTRY_DSN=

# Optional.
# GEMMA_MODEL=gemma-4-26b-a4b-it
# PORT=8000
